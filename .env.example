# Shelby API Key (optional but recommended) - https://geomi.dev/
NEXT_PUBLIC_SHELBYNET_API_KEY=

# Optional: enable simple file-based video registry for incognito / multi-device listing
# ENABLE_VIDEO_REGISTRY=true

# Optional: server-only Shelby API key
# SHELBYNET_API_KEY=

# Indexer: default is testnet. Override for shelbynet:
# NEXT_PUBLIC_SHELBY_INDEXER_URL=https://api.shelbynet.shelby.xyz/v1/graphql

# Aptos network: Shelby Early Access uses Aptos testnet (default)
# Set to "mainnet" only when Shelby production is on mainnet
# NEXT_PUBLIC_APTOS_NETWORK=mainnet

# Solana RPC (optional - defaults to Devnet)
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
